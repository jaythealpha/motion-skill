  "events": [
    {
      "id": "before",
      "at": "2019-04-15T18:30",
      "kind": "note",
      "title": {
        "ko": "화재 이전의 구조",
        "en": "Before the fire"
      },
      "text": {
        "ko": "쌍탑·석조 벽과 목조 지붕·첨탑을 구분해 보세요. 첨탑 둘레에는 당시 보수 비계가 있었습니다.",
        "en": "Compare stone towers and walls with the timber roof and spire; a restoration scaffold already surrounded the spire."
      },
      "confidence": "sourced",
      "sourceIds": [
        "damage"
      ]
    },
    {
      "id": "alarm",
      "at": "2019-04-15T18:45",
      "kind": "note",
      "title": {
        "ko": "지붕 화재",
        "en": "Roof fire"
      },
      "text": {
        "ko": "4월 15일 저녁 지붕에서 불이 번집니다. 화염 크기·확산과 중간 시각은 설명용 추정입니다.",
        "en": "The roof burns on the evening of 15 April. Flame scale, spread and intermediate timing are illustrative."
      },
      "confidence": "sourced",
      "sourceIds": [
        "fire"
      ]
    },
    {
      "id": "collapse",
      "at": "2019-04-15T19:45",
      "kind": "note",
      "title": {
        "ko": "첨탑 붕괴",
        "en": "Spire collapse"
      },
      "text": {
        "ko": "문화부 회고는 첨탑 붕괴를 약 19:45로 기록합니다. 기울기·낙하 경로는 추정이며 석조 쌍탑 전체가 무너진 것은 아닙니다.",
        "en": "A ministry account places the spire collapse around 19:45. Its motion is estimated; the stone twin towers did not collapse."
      },
      "confidence": "sourced",
      "sourceIds": [
        "fire"
      ]
    },
    {
      "id": "night",
      "at": "2019-04-15T21:00",
      "kind": "note",
      "title": {
        "ko": "남아 있는 석조 구조",
        "en": "Surviving stone structure"
      },
      "text": {
        "ko": "지붕·첨탑과 볼트 일부가 손상됩니다. 장미창과 주요 석조 구조는 남아 있습니다.",
        "en": "The roof, spire and parts of the vault are damaged. Rose windows and the main stone structure survive."
      },
      "confidence": "sourced",
      "sourceIds": [
        "damage"
      ]
    },
    {
      "id": "control",
      "at": "2019-04-16T03:45",
      "kind": "note",
      "title": {
        "ko": "지붕 화재 진정",
        "en": "Roof fire brought under control"
      },
      "text": {
        "ko": "문화부 회고는 지붕 화재가 새벽 03:45경 진정됐다고 기록합니다. 잔해·그을음 위치는 추정 도해입니다.",
        "en": "The ministry account places control of the roof fire around 03:45. Debris and soot positions are illustrative."
      },
      "confidence": "sourced",
      "sourceIds": [
        "rebirth"
      ]
    },
    {
      "id": "tarp",
      "at": "2019-04-19",
      "kind": "note",
      "title": {
        "ko": "임시 덮개·긴급 지지",
        "en": "Temporary protection"
      },
      "text": {
        "ko": "4월 19일까지 높은 볼트 위의 임시 방수 덮개가 설치됩니다. 부벽과 볼트의 지지·안정화가 이어집니다.",
        "en": "Temporary high-vault weather protection is in place by 19 April; buttress and vault stabilisation continues."
      },
      "confidence": "sourced",
      "sourceIds": [
        "damage"
      ]
    },
    {
      "id": "scaffold",
      "at": "2020-11-24",
      "kind": "note",
      "title": {
        "ko": "손상 비계 철거",
        "en": "Damaged scaffold removed"
      },
      "text": {
        "ko": "화재 때 남았던 첨탑 비계의 철거가 완료됩니다. 이후 볼트 조사와 보수 접근이 나아집니다.",
        "en": "Removal of the fire-damaged spire scaffold is completed, improving access to the vaults."
      },
      "confidence": "sourced",
      "sourceIds": [
        "secure"
      ]
    },
    {
      "id": "restoration",
      "at": "2022-07-01",
      "kind": "note",
      "title": {
        "ko": "구조 복원 준비·시공",
        "en": "Restoration works"
      },
      "text": {
        "ko": "2022년 여름 내부 복원 작업이 본격화됩니다. 도해의 트러스·석재 조립 순서와 중간 형상은 추정입니다.",
        "en": "Interior restoration intensifies in summer 2022. Truss and masonry assembly sequences in this study are estimated."
      },
      "confidence": "sourced",
      "sourceIds": [
        "rebirth"
      ]
    },
    {
      "id": "spire",
      "at": "2023-12-16",
      "kind": "note",
      "title": {
        "ko": "첨탑 실루엣의 귀환",
        "en": "Spire silhouette returns"
      },
      "text": {
        "ko": "12월 16일 첨탑 꼭대기에 수탉 장식이 놓입니다. 지붕 골조와 덮개 공사는 이후에도 이어집니다.",
        "en": "The cockerel is installed on 16 December; roof-frame and covering works continue."
      },
      "confidence": "sourced",
      "sourceIds": [
        "rebirth"
      ]
    },
    {
      "id": "reopen",
      "at": "2024-12-08",
      "kind": "note",
      "title": {
        "ko": "재개관",
        "en": "Reopening"
      },
      "text": {
        "ko": "2024년 12월 재개관을 맞습니다. 이는 모든 보존 공사가 끝났다는 의미가 아닙니다.",
        "en": "The cathedral reopens in December 2024; this does not mean every conservation project is finished."
      },
      "confidence": "sourced",
      "sourceIds": [
        "reopen"
      ]
    }
